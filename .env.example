# Application Configuration
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret
FLASK_DEBUG=False
APP_NAME=Inventory Management System
APP_VERSION=2.0.0
TIMEZONE=Asia/Ho_Chi_Minh

# Database Configuration
POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://inventory_user:change-this-db-password@inventory-postgres:5432/inventory_db

# Admin Account
ADMIN_PASSWORD=change-this-admin-password

# Reverse proxy / tunnel
# Cloudflare Tunnel normally terminates HTTPS before reaching this container.
PREFERRED_URL_SCHEME=https
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=true

# Host paths for the /opt/docker + /srv layout.
INVENTORY_APP_DIR=/srv/inventory/app
INVENTORY_DATA_DIR=/srv/inventory/data
POSTGRES_DATA_DIR=/srv/postgres/inventory/data
REDIS_DATA_DIR=/srv/redis/inventory/data
INVENTORY_NGINX_CONF=/opt/docker/configs/inventory/nginx.conf
INVENTORY_SSL_DIR=/opt/docker/configs/inventory/ssl
INVENTORY_INIT_SSL=/opt/docker/scripts/inventory/init-ssl.sh
INVENTORY_ENV_FILE=/opt/docker/secrets/inventory/inventory.env

# Bind to 127.0.0.1 for Cloudflare Tunnel only.
# Change INVENTORY_HTTP_BIND to 0.0.0.0 if you want LAN devices to open it directly.
INVENTORY_HTTP_BIND=127.0.0.1
INVENTORY_HTTP_PORT=8088
INVENTORY_HTTPS_BIND=127.0.0.1
INVENTORY_HTTPS_PORT=8443

# Backup Configuration
BACKUP_ENABLED=False
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
