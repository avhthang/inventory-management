# Production Environment Configuration
# Copy this to /opt/docker/secrets/inventory/inventory.env and update the secrets.

FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=False

POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://inventory_user:change-this-db-password@inventory-postgres:5432/inventory_db

ADMIN_PASSWORD=change-this-admin-password

INVENTORY_APP_DIR=/srv/inventory/app
INVENTORY_DATA_DIR=/srv/inventory/data
POSTGRES_DATA_DIR=/srv/postgres/inventory/data
REDIS_DATA_DIR=/srv/redis/inventory/data
INVENTORY_NGINX_CONF=/opt/docker/configs/inventory/nginx.conf
INVENTORY_SSL_DIR=/opt/docker/configs/inventory/ssl
INVENTORY_INIT_SSL=/opt/docker/scripts/inventory/init-ssl.sh
INVENTORY_ENV_FILE=/opt/docker/secrets/inventory/inventory.env

# Cloudflare Tunnel: keep 127.0.0.1 and point the tunnel to http://localhost:8088.
# LAN direct access: change INVENTORY_HTTP_BIND to 0.0.0.0.
INVENTORY_HTTP_BIND=127.0.0.1
INVENTORY_HTTP_PORT=8088
INVENTORY_HTTPS_BIND=127.0.0.1
INVENTORY_HTTPS_PORT=8443

PREFERRED_URL_SCHEME=https
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=true

BACKUP_ENABLED=False
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

SESSION_TIMEOUT_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

APP_NAME=Inventory Management System
APP_VERSION=2.0.0
TIMEZONE=Asia/Ho_Chi_Minh

LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

WORKERS=4
MAX_REQUESTS=1000
TIMEOUT=300
